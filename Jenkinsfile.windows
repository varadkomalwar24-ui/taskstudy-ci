pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Install Dependencies') {
            steps {
                bat 'python -m pip install -r requirements.txt'
            }
        }
        stage('Lint') {
            steps {
                bat 'python -m flake8 app tests'
            }
        }
        stage('Test') {
            steps {
                bat 'python -m pytest --cov=app --cov-report=xml --junitxml=test-results.xml'
            }
            post {
                always {
                    junit 'test-results.xml'
                }
            }
        }
    }

    post {
        success { echo 'CI build passed.' }
        failure { echo 'CI build failed. Check the console output.' }
    }
}
